# ==============================================================================
# Smart Weather Alert System - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Option A: TiDB Cloud Starter (Render Deployment)
# ------------------------------------------------------------------------------
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=smart_weather_db
# DB_USER=your_tidb_username.root
# DB_PASSWORD=your_tidb_password
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# ENABLE_DB_FALLBACK=false

# ------------------------------------------------------------------------------
# Option B: Local MySQL / XAMPP (Local Development)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=weather_db
DB_USER=root
DB_PASSWORD=
DB_SSL_CA=
ENABLE_DB_FALLBACK=true

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_DEBUG=0
BACKEND_PORT=5000
API_KEY=WEATHER_FARM_KEY_2026
